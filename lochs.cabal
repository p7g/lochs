cabal-version:      3.0
name:               lochs
version:            0.1.0.0
synopsis: Haskell implementation of Bob Nystrom's Lox programming language
license:            MIT
license-file:       LICENSE
author:             Patrick Gingras
maintainer:         775.pg.12@gmail.com
category:           Language
build-type:         Simple

common warnings
    ghc-options: -O2 -Wall -funbox-strict-fields

executable lochs
    import:           warnings
    main-is:          Main.hs
    other-modules:    Lochs.AST
                    , Lochs.Diagnostic
                    , Lochs.Compile
                    , Lochs.Parser
                    , Lochs.Resolver
                    , Lochs.Runtime
                    , Lochs.Scanner
    build-depends:    base ^>=4.20.0.0
                    , containers
                    , dynamic-array
                    , text
    hs-source-dirs:   src
    default-language: GHC2024
